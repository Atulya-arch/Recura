{
  "name": "recura",
  "version": "1.0.0",
  "private": true,
  "description": "Recura - AI Revenue Recovery, on Autopilot",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --config client/vite.config.ts client",
    "build": "tsc -b && vite build client",
    "start": "NODE_ENV=production tsx server/index.ts",
    "seed": "tsx scripts/seed.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "demo": "tsx scripts/demo.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "@google/generative-ai": "^0.24.0",
    "@tanstack/react-query": "^5.67.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.0",
    "express": "^4.21.2",
    "lucide-react": "^0.477.0",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.3.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.1",
    "vitest": "^3.0.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "ts-node": "^10.9.2"
  }
}
